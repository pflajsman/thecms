# Server Configuration
PORT=3000
NODE_ENV=development

# Database (Cosmos DB with MongoDB API)
MONGODB_URI=mongodb://localhost:27017/thecms

# Microsoft Entra External ID Configuration
AZURE_ENTRA_TENANT_NAME=your-tenant-name
AZURE_ENTRA_TENANT_ID=your-tenant-id
AZURE_ENTRA_CLIENT_ID=your-backend-client-id

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
AZURE_STORAGE_CONTAINER_NAME=media

# Brevo (transactional email)
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=noreply@yourdomain.com

# Application Insights (Optional for local dev)
APPLICATIONINSIGHTS_CONNECTION_STRING=your-app-insights-connection-string

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Shop emails: sender name, and the public API base URL used in download links
BREVO_FROM_NAME=TheCMS
PUBLIC_API_URL=http://localhost:3000/api/v1

# AI assistant: 32-byte secret that encrypts users' AI keys (base64 or hex), for example: openssl rand -base64 32
# Without it the AI features are off. Changing it makes stored keys unreadable; users connect again.
AI_KEY_SECRET=
# Allow AI base URLs on this machine or a private network in production (for a self-hosted model). Default: off.
AI_ALLOW_PRIVATE_URLS=false

# Superadmins: comma-separated Entra subject ids (preferred) or email addresses
SUPERADMINS=
# Admin dashboard URL, used in invitation links
ADMIN_URL=http://localhost:5173
